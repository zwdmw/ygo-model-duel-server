# Include from nginx's http context. Native TCP clients use the public bridge.
map $http_upgrade $ygo_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name compute.example.com;
    ssl_certificate /etc/letsencrypt/live/compute.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/compute.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 128k;
    location / {
        proxy_pass http://127.0.0.1:6006;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ygo_connection_upgrade;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_buffering off;
    }
}
